# SalesAgent — the ONLY .env this app reads (no cross-project fallbacks).
# Copy to .env and fill in. The real .env is gitignored — move it between
# machines by file copy (it rides in the deploy bundle, see DEPLOY.md).

ANTHROPIC_API_KEY=
SEAMLESS_API_KEY=

# Serper.dev (web search + open/closed verification); empty = DDG fallback
SERPER_API_KEY=
GOOGLE_PLACES_API_KEY=

# price_comparison app (price_scrape / price_own tools); empty = not configured
PRICE_COMPARISON_URL=http://192.168.18.6:8508/

# Acumatica (read-only OData GIs: prices + stock); empty = direct path disabled
ACUMATICA_URL=https://eisco.acumatica.com
ACUMATICA_TENANT=Eisco LIVE
ACUMATICA_USERNAME=
ACUMATICA_PASSWORD=
ACUMATICA_PRICE_CLASS=SHOPGUEST

# Models
ORCHESTRATOR_MODEL=claude-sonnet-5
EXTRACT_MODEL=claude-haiku-4-5

# Seamless credit rails
SEAMLESS_DAY_CAP=200
SEAMLESS_CONFIRM_THRESHOLD=5
SEAMLESS_CONVO_BUDGET=25
# 1 = synthetic dry-run (safe default); 0 = LIVE credits (confirm cards +
# day cap + convo budget still gate every spend). NOTE when flipping 1 -> 0:
# purge dry-run rows from contacts_app + provider='seamless_search' api_cache
# entries, or live searches will cache-hit synthetic people.
SEAMLESS_DRY_RUN=1

# Agent loop
AGENT_RECURSION_LIMIT=1000000
AGENT_STEP_WARN_EVERY=50

PORT=8504
# In Docker these are set by the run line (-e DATA_DIR=C:/data etc.)
# DATA_DIR=
# PROMPTS_DIR=
